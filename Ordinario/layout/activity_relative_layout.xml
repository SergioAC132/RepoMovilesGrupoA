<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp"
    android:background="#F1F5F9">

    <TextView
        android:id="@+id/txtTitulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="RelativeLayout"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#1E293B"
        android:layout_centerHorizontal="true"
        android:layout_alignParentTop="true"
        android:layout_marginTop="20dp" />

    <TextView
        android:id="@+id/txtDescripcion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Cada elemento tiene una posición relativa"
        android:textSize="14sp"
        android:textColor="#475569"
        android:layout_below="@id/txtTitulo"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/txtIzquierda"
        android:layout_width="140dp"
        android:layout_height="100dp"
        android:text="ELEMENTO A\nIzquierda"
        android:gravity="center"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:background="#2563EB"
        android:layout_alignParentStart="true"
        android:layout_below="@id/txtDescripcion"
        android:layout_marginTop="55dp" />

    <TextView
        android:id="@+id/txtDerecha"
        android:layout_width="140dp"
        android:layout_height="100dp"
        android:text="ELEMENTO B\nDerecha"
        android:gravity="center"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:background="#7C3AED"
        android:layout_alignParentEnd="true"
        android:layout_alignTop="@id/txtIzquierda" />

    <TextView
        android:id="@+id/txtCentro"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ELEMENTO C: CENTRADO"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:padding="16dp"
        android:background="#059669"
        android:layout_centerInParent="true" />

    <Button
        android:id="@+id/btnRegresar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Regresar al menú"
        android:layout_alignParentBottom="true" />

</RelativeLayout>
